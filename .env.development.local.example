# Local dev only — read automatically by `next dev`, ignored by `next build`/
# `next start` (see the "Como correr" section of README.md). Points the app
# at the Supabase instance that runs on this machine via Docker
# (`npm run supabase:start`), completely separate from production.
#
# Copy this file to .env.development.local, then run `npm run supabase:start`
# and paste the "API URL", "anon key" and "service_role key" it prints. Those
# three values are fixed for local dev and safe to keep here even though the
# file with the real values is (correctly) gitignored — they only work
# against http://127.0.0.1, never against the real project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Same API-Football key as .env.local — there's only one subscription, so
# dev and prod share it. Leave this out of this file and it'll fall back to
# whatever's in .env.local.
# API_FOOTBALL_KEY=
